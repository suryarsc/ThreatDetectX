# ThreatDetectX Configuration Template
# Copy this file to .env and provide your credentials

# AbuseIPDB Threat Intelligence API Key (Get a free key from https://www.abuseipdb.com/)
ABUSEIPDB_KEY=

# AWS S3 Storage Ingestion (Created via Terraform or AWS Console)
TDX_S3_BUCKET=tdx-security-logs-dev-example
AWS_REGION=us-east-1

# Optional API Port
PORT=5000
